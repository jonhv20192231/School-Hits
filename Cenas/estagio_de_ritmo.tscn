[sub_resource type="GDScript" id="GDScript_lom1m"]
script/source = "extends Node

@onready var condutor: Node = $Condutor

func _ready() -> void:
	# Inicia a música e o condutor quando a cena carregar
	if condutor and condutor.has_method(\"iniciar\"):
		condutor.iniciar()
"

[sub_resource type="GDScript" id="GDScript_aii71"]
script/source = "extends Node2D

@export var tecla_input: String = \"ui_up\" # Altera para a ação definida nos Project Settings


@onready var zona_de_hit: Node2D = $ZonaDeHit
@onready var container_de_notas: Node2D = $ContainerDeNotas

var notas_na_zona: Array = []

func _ready() -> void:
	if zona_de_hit:
		zona_de_hit.body_entered.connect(_on_zona_body_entered)
		zona_de_hit.body_exited.connect(_on_zona_body_exited)

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(tecla_input):
		verificar_acerto()

func verificar_acerto() -> void:
	if notas_na_zona.size() > 0:
		var nota_alvo = notas_na_zona[0]
		print(\"Acertaste na nota!\")
		nota_alvo.queue_free()
		notas_na_zona.pop_front()
	else:
		print(\"Erraste! (Tecla premida sem nota)\")

func _on_zona_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"notas\"):
		notas_na_zona.append(body)

func _on_zona_body_exited(body: Node2D) -> void:
	if body.is_in_group(\"notas\"):
		if body in notas_na_zona:
			notas_na_zona.erase(body)
			print(\"Miss!\")
			body.queue_free()
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_5l23l"]

[sub_resource type="GDScript" id="GDScript_blgnd"]
script/source = "extends Node2D

@export var tecla_input: String = \"ui_up\" # Ação configurada no Input Map

@onready var zona_de_hit: Area2D = $ZonaDeHit
@onready var container_de_notas: Node2D = $ContainerDeNotas

var notas_na_zona: Array = []

func _ready() -> void:
	if zona_de_hit:
		# Como usamos Area2D, o sinal correto é area_entered / area_exited
		zona_de_hit.area_entered.connect(_on_zona_area_entered)
		zona_de_hit.area_exited.connect(_on_zona_area_exited)

func _unhandled_input(event: InputEvent) -> void:
	if event.is_action_pressed(tecla_input):
		verificar_acerto()

func verificar_acerto() -> void:
	if notas_na_zones_tem_itens():
		var nota_alvo = notas_na_zona[0]
		if is_instance_valid(nota_alvo):
			print(\"Acertou a nota!\")
			nota_alvo.queue_free()
			notas_na_zona.pop_front()
	else:
		print(\"Erraste! (Tecla premida sem nota na zona)\")

func notas_na_zones_tem_itens() -> bool:
	# Limpa referências inválidas caso alguma nota tenha sido apagada antes
	while notas_na_zona.size() > 0 and not is_instance_valid(notas_na_zona[0]):
		notas_na_zona.pop_front()
	return notas_na_zona.size() > 0

func _on_zona_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"notas\"):
		notas_na_zona.append(area)

func _on_zona_area_exited(area: Area2D) -> void:
	if area.is_in_group(\"notas\"):
		if area in notas_na_zona:
			notas_na_zona.erase(area)
			print(\"Miss! Passou da zona.\")
			area.queue_free()
"

