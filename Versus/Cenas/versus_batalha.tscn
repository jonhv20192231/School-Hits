[sub_resource type="GDScript" id="GDScript_y7jmb"]
script/source = "extends Control

# Atualizado com os nomes exatos dos seus botões
@onready var retornar_ao_jogo_button: Button = $CenterContainer/VBoxContainer/RetornarAoJogo
@onready var voltar_ao_jogo_button: Button = $CenterContainer/VBoxContainer/VoltarAoJogo

func _ready() -> void:
	# Esconde o menu inicialmente
	visible = false
	
	# Conecta os sinais de clique dos botões
	retornar_ao_jogo_button.pressed.connect(_on_retornar_ao_jogo_pressed)
	voltar_ao_jogo_button.pressed.connect(_on_voltar_ao_jogo_pressed)

func _unhandled_input(event: InputEvent) -> void:
	# Detecta se a tecla ESC foi pressionada
	if event.is_action_pressed(\"ui_cancel\"):
		toggle_pause()

func toggle_pause() -> void:
	var is_paused = get_tree().paused
	get_tree().paused = !is_paused
	visible = get_tree().paused

func _on_retornar_ao_jogo_pressed() -> void:
	toggle_pause()

func _on_voltar_ao_jogo_pressed() -> void:
	# 1. IMPORTANTE: Despausa o jogo antes de sair da cena atual
	get_tree().paused = false
	
	get_tree().change_scene_to_file(\"res://Cenas/menu.tscn\")
"

